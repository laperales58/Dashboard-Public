ADMIN_PASSWORD=replace-with-your-admin-password
SESSION_SECRET=replace-with-a-long-random-string
WEBHOOK_SECRET=replace-with-a-different-long-random-string
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
DATABASE_SSL=true
# Powers the Grants > Budget > Expenses receipt-photo reader. Get a key at platform.claude.com
# (separate account/billing from claude.ai). Leave blank to disable receipt reading -- uploads
# still save the photo so you can fill in the details by hand.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
HOST=127.0.0.1
PORT=8765
# Only used by scripts/seed-demo-data.js (fills a demo database with fake data). Never point this at the real database.
DEMO_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DEMO_DB?sslmode=require
